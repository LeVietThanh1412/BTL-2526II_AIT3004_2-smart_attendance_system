APP_NAME="Smart Attendance API"
APP_VERSION=1.0.0
DEBUG=false

MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=smart_attendance_db
MYSQL_USER=attendance_admin
MYSQL_PASSWORD=change_me_db_password
MYSQL_HOST=mysql
MYSQL_PORT=3307

DATABASE_URL=mysql+pymysql://attendance_admin:change_me_db_password@mysql:3306/smart_attendance_db

# Redis and Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_EMBEDDING_TTL_SECONDS=86400

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=face_embeddings

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio_password
MINIO_BUCKET=attendance-images
MINIO_SECURE=false
MINIO_PUBLIC_BASE_URL=http://localhost:9000

# Face AI
DEEPFACE_MODEL_NAME=your_model_choice
FACE_DETECTOR_BACKEND=your_detector_choice
FACE_MATCH_THRESHOLD=0.7
FACE_DETECTION_CONFIDENCE=0.5
MIN_REGISTRATION_IMAGES=3

#Camera
TIME_LATE=07:30
DEFAULT_CAMERA_ID=cam_01

# Remote S3 Backup Configs
REMOTE_S3_URL=https://s3.amazonaws.com
REMOTE_S3_ACCESS_KEY=your_aws_access_key
REMOTE_S3_SECRET_KEY=your_aws_secret_key
REMOTE_S3_BUCKET=your_backup_bucket

