# App
APP_NAME=Smart Attendance API
APP_VERSION=1.0.0
DEBUG=false

# MySQL / PostgreSQL (Postgres recommended, but MySQL supported)
MYSQL_URL=mysql+pymysql://user:pass@db:3306/attendance_db

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Qdrant
QDRANT_URL=http://qdrant:6333

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=attendance-images
MINIO_SECURE=false

# Face AI
FACE_SIMILARITY_THRESHOLD=0.6
MIN_REGISTRATION_IMAGES=3

# Redis embedding TTL (seconds)
REDIS_EMBEDDING_TTL_SECONDS=86400
