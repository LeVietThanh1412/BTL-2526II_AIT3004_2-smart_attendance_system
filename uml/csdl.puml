@startuml ERD_Smart_Attendance
skinparam linetype ortho
skinparam roundcorner 5
skinparam shadowing false
skinparam nodesep 60
skinparam ranksep 60

' Định nghĩa style cho các entity
skinparam entity {
    BackgroundColor LightYellow
    BorderColor Black
}

entity "users" as users {
  *id : integer <<PK>>
  --
  student_id : varchar(30) <<Unique>>
  full_name : varchar(255)
  class_name : varchar(50)
  is_approved : boolean <<Default: False>>
  created_at : datetime
}

entity "student_schedules" as schedules {
  *id : integer <<PK>>
  --
  user_id : integer <<FK>>
  day_of_week : integer <<Ví dụ: 2, 3, 4, 5, 6, 7>>
  shift_name : varchar(20) <<'Ca 1', 'Ca 2', 'Ca 3', 'Ca 4'>>
  is_active : boolean <<Default: True>>
  created_at : datetime
}

entity "attendances" as attendances {
  *id : integer <<PK>>
  --
  user_id : integer <<FK>>
  check_in_time : datetime
  check_out_time : datetime <<Nullable>>
  camera_id : varchar(50)
  confidence_score : float
  is_late : boolean <<Default: False>>
  is_late_override : boolean <<Default: False>>
  status : varchar(50) <<'present', 'absent', 'present_incomplete'>>
}

entity "face_embeddings (Qdrant)" as qdrant_vectors {
  *id : UUID <<PK>>
  --
  student_id : varchar(30) <<Indexed>>
  user_id : integer
  vector : float[512]
}

' Định nghĩa các mối quan hệ
users ||--o{ schedules : "1 sinh viên có nhiều ca học"
users ||--o{ attendances : "1 sinh viên có nhiều phiên điểm danh"
users ||--o{ qdrant_vectors : "1 sinh viên có nhiều ảnh/vector"

@enduml