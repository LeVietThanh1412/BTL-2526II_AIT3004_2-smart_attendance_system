@startuml UseCase_Diagram
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam linetype ortho

' Custom styles for a clean, modern look
skinparam usecase {
    BackgroundColor LightCyan
    BorderColor SteelBlue
    ArrowColor DimGray
    FontName Arial
    FontSize 11
}
skinparam actor {
    BackgroundColor White
    BorderColor SteelBlue
    FontName Arial
}
skinparam rectangle {
    BorderColor SteelBlue
    FontName Arial
}

actor "Sinh viên" as SV
actor "Quản lý /\nGiảng viên" as GV
actor "Hệ thống\n(Tự động)" as SYS

rectangle "Smart Attendance System" {

    ' === Use cases của Sinh viên ===
    usecase "Đăng ký khuôn mặt\n(Ảnh / Video)" as UC_Register
    usecase "Đăng ký lịch học" as UC_Schedule
    usecase "Đổi ca học" as UC_ChangeShift
    usecase "Điểm danh\n(Check-in / Check-out)" as UC_CheckIn
    usecase "Xem lịch sử\nđiểm danh cá nhân" as UC_PersonalHistory

    ' === Use cases của Admin ===
    usecase "Đăng nhập quản trị" as UC_Login
    usecase "Duyệt sinh viên" as UC_Approve
    usecase "Quản lý lịch học\n(Duyệt / Từ chối)" as UC_ManageSchedule
    usecase "Sửa trạng thái\nđiểm danh (Override)" as UC_Override
    usecase "Xem Dashboard\nthống kê" as UC_Dashboard
    usecase "Xem nhật ký\nđiểm danh" as UC_ViewLogs
    usecase "Xuất báo cáo\n(CSV)" as UC_ExportCSV
    usecase "Xem thông báo" as UC_Notification

    ' === Use cases nội bộ hệ thống ===
    usecase "Trích xuất vector\nkhuôn mặt (AI)" as UC_ExtractVector
    usecase "Nhận diện\nkhuôn mặt (AI)" as UC_FaceMatch
    usecase "Phát hiện\nđi muộn" as UC_DetectLate
    usecase "Cronjob quét\nvắng mặt (23:59)" as UC_CronAbsent
}

' === Sinh viên ===
SV --> UC_Register
SV --> UC_Schedule
SV --> UC_ChangeShift
SV --> UC_CheckIn
SV --> UC_PersonalHistory

' === Admin ===
GV --> UC_Login
GV --> UC_Approve
GV --> UC_ManageSchedule
GV --> UC_Override
GV --> UC_Dashboard
GV --> UC_ViewLogs
GV --> UC_ExportCSV
GV --> UC_Notification

' === Hệ thống tự động ===
SYS --> UC_CronAbsent

' === Quan hệ include ===
UC_Register ..> UC_ExtractVector : <<include>>
UC_CheckIn ..> UC_FaceMatch : <<include>>

' === Quan hệ extend ===
UC_CheckIn ..> UC_DetectLate : <<extend>>
UC_Dashboard ..> UC_ViewLogs : <<extend>>

' === Quan hệ khác ===
UC_ChangeShift ..> UC_ManageSchedule : <<extend>>

@enduml